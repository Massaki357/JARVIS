.env
__pycache__/
*.pyc
venv/

# dados/ guarda o estado que o app gera nesta máquina. As pastas e os
# arquivos abaixo são recriados sozinhos quando faltam (ver
# jarvis/caminhos.py), então nunca são versionados:

# admin_terminal: log local de comandos administrativos e a pasta de
# troca de arquivos (pedido/resultado) com o processo elevado.
dados/logs/comandos_admin.log
dados/admin_fila/

# abrir_app_local: cache técnico nome->AppID. O pacote foi removido
# (substituído por abrir_aplicativo, que não usa cache em disco), mas
# a linha fica para o arquivo antigo de quem já tinha um não voltar a
# aparecer como novidade no Git.
dados/apps_conhecidos.json

# discord_jarvis: cache técnico nome->contato e nome->canal do
# Discord — específico da conta/servidor do usuário, nunca
# versionado (e contém IDs reais de pessoas).
dados/discord_contatos.json
dados/discord_canais.json

# Continuam versionados, como já eram antes desta reorganização:
#   dados/memoria.json                 (memória conversacional)
#   dados/agenda.json                  (compromissos do pacote agenda)
#   dados/logs/comandos_remotos.log    (log do rede_jarvis)
#   config.json                        (preferência local da máquina)
#
# dados/agenda.json segue a mesma regra de dados/memoria.json (era
# versionado no projeto do curso também). Se você preferir manter seus
# compromissos fora do Git, acrescente "dados/agenda.json" aqui.
JARVIS_COMPLETO

# Perfis do jarvis (dados/perfis/): a PASTA de cada perfil é a fonte
# da verdade e continua versionada, mesma regra de dados/memoria.json
# e dados/agenda.json — o perfil padrão "completo/" carrega o prompt
# de sistema do projeto, e os perfis que o usuário criar são a
# configuração dele. O que NÃO é versionado é só o índice, que é 100%
# derivado dessas pastas, carrega um "gerado_em" que muda a cada
# regravação, e se refaz sozinho quando falta
# (jarvis/nucleo/perfis/armazenamento.py::reconstruir_indice).
dados/perfis/indice.json
